# zaloclaw-studio runtime config for the systemd (Option A) install.
# Copy to deploy/zaloclaw.env and edit, or pass the same values as install.sh flags.
#
# HOST determines which interface uvicorn binds:
#   127.0.0.1        local only (default, safest for a fresh machine)
#   100.x.y.z        a Tailscale interface IP (run `tailscale ip -4` to find it)
#   0.0.0.0          every interface (only behind a firewall / trusted LAN)
HOST=127.0.0.1

# Two roles run as two services on two ports.
PANEL_PORT=18090
G2G_PORT=18091

# Role split is baked into the unit files (campaign / g2g); do not override here.
# ZS_ROLE=campaign   # set inside zaloclaw-studio-panel.service
# ZS_ROLE=g2g        # set inside zaloclaw-g2g.service
